<configuration>
  <!-- Sistema de arquivos padrão: HDFS NameNode -->
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://hadoop-namenode:8020</value>
  </property>

  <!-- RPC do NameNode (opcional, muitas vezes herdado do defaultFS) -->
  <property>
    <name>dfs.hadoop-namenode.rpc-address</name>
    <value>hadoop-namenode:8020</value>
  </property>

  <!-- Diretório temporário local (usado pelo Hadoop) -->
  <property>
    <name>hadoop.tmp.dir</name>
    <value>/hadoop/tmp</value>
  </property>

  <!-- Número de réplicas (apenas para dev/test) -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>

  <!-- Ponto de acesso Web UI do NameNode -->
  <property>
    <name>dfs.hadoop-namenode.http-address</name>
    <value>hadoop-namenode:9870</value>
  </property>
</configuration>
